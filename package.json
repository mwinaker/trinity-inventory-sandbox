{
  "name": "trinity-billet-inventory",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "serve": "node server/index.mjs",
    "start": "node server/index.mjs",
    "analytics:export": "node scripts/export-customer-sessions.mjs",
    "analytics:report": "node scripts/export-customer-sessions.mjs --days=30",
    "analytics:orders": "node scripts/export-order-attribution.mjs --days=14",
    "analytics:check": "node scripts/check-analytics-pipeline.mjs",
    "analytics:backfill": "node scripts/backfill-analytics-gaps.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
