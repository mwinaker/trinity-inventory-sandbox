{% assign trinity_reference = "" %}{% assign trinity_reference_count = 0 %}{% assign trinity_reference_verified = false %}{% assign trinity_owner_prefix = "T-REF-O" %}{% if name contains "#D" %}{% assign trinity_owner_prefix = "T-REF-D" %}{% endif %}{% assign trinity_owner_tag = trinity_owner_prefix | append: id %}{% for tag in tags %}{% assign trinity_prefix = tag | slice: 0, 2 %}{% if trinity_prefix == "T-" and tag.size == 7 %}{% assign trinity_reference = tag %}{% assign trinity_reference_count = trinity_reference_count | plus: 1 %}{% endif %}{% if tag == trinity_owner_tag %}{% assign trinity_reference_verified = true %}{% endif %}{% endfor %}{% if trinity_reference_count != 1 %}{% assign trinity_reference_verified = false %}{% endif %}<!-- QUOTE -->{% assign document_date_format = "%Y-%m-%d %H:%M:%S %z" %}<div class="invoice">  <div class="header">    <div class="brand">{% if shop_logo_url != blank %}{{ shop_logo_url | img_tag: shop.name, 'shop-logo' }}{% else %}{{ shop.name }}{% endif %}</div>    <div class="document-title">{% if trinity_reference != blank %}<strong>{% if name contains "#D" %}Invoice{% elsif financial_status == "paid" %}Paid invoice{% else %}Invoice{% endif %}<br>{% if trinity_reference_verified %}{{ trinity_reference | escape }}{% else %}Reference pending{% endif %}</strong><br>Shopify {{ name }}<br>{% if cancelled_at != blank %}CANCELLED{% elsif financial_status == "paid" %}PAID{% elsif financial_status == "partially_paid" %}PARTIALLY PAID{% elsif financial_status == "refunded" %}REFUNDED{% elsif financial_status == "partially_refunded" %}PARTIALLY REFUNDED{% else %}UNPAID{% endif %}<br>{% else %}<strong>Invoice {{ name }}</strong><br>{% if cancelled_at != blank %}CANCELLED{% elsif financial_status == "paid" %}PAID{% elsif financial_status == "partially_paid" %}PARTIALLY PAID{% elsif financial_status == "refunded" %}REFUNDED{% elsif financial_status == "partially_refunded" %}PARTIALLY REFUNDED{% else %}UNPAID{% endif %}<br>{% endif %}{{ created_at | date: document_date_format }}</div>  </div>  <div class="addresses">    {% if shipping_address != blank %}<div><h3>Shipping address</h3>{{ shipping_address | format_address }}</div>{% endif %}    {% if billing_address != blank %}<div><h3>Customer</h3>{{ billing_address | format_address }}</div>{% endif %}    {% if shipping_method != blank %}<div><h3>Shipping method</h3>{{ shipping_method.title }}</div>{% endif %}  </div>  <table class="items">    <thead><tr><th>Model</th><th class="right">Length</th><th class="right">Weight</th><th class="right">Qty</th><th class="right">Price</th></tr></thead>    <tbody>      {% for line_item in line_items %}        {% if line_item.quantity > 0 %}          {% assign trinity_model = line_item.product_title %}          {% assign trinity_length = "" %}          {% assign trinity_weight = "" %}          {% for p in line_item.properties %}            {% if p.first == "trinity_model" and p.last != blank %}{% assign trinity_model = p.last %}{% endif %}            {% if p.first == "trinity_length" and p.last != blank %}{% assign trinity_length = p.last %}{% endif %}            {% if p.first == "trinity_weight" and p.last != blank %}{% assign trinity_weight = p.last %}{% endif %}          {% endfor %}          <tr><td>{{ trinity_model }}</td><td class="right">{% if trinity_length != blank %}{{ trinity_length }} in{% else %}-{% endif %}</td><td class="right">{% if trinity_weight != blank %}{{ trinity_weight }} oz{% else %}-{% endif %}</td><td class="right">{{ line_item.quantity }}</td><td class="right">{{ line_item.line_price | money }}</td></tr>        {% endif %}      {% endfor %}    </tbody>  </table>  <div class="summary"><div class="totals"><div><span>Subtotal</span><span>{{ subtotal_price | money }}</span></div><div><span>Shipping</span><span>{{ shipping_price | default: 0.0 | money }}</span></div>{% for tax in tax_lines %}<div><span>{{ tax.title }}</span><span>{{ tax.price | money }}</span></div>{% endfor %}<div class="total"><span>Total ({{ currency }})</span><span>{{ total_price | money }}</span></div></div></div>    {% if trinity_reference == blank %}<div class="payment-instructions">    <a class="payment-button" href="{{ invoice_url }}" target="_blank">Pay online</a>    <h3>Check payment</h3>    <p>If you prefer to pay by check, please make checks payable to <strong>Trinity Sports Group LLC</strong> and mail them to:</p>    <p class="payment-address">Trinity Sports Group LLC<br>2493 E Orangethorpe Ave<br>Fullerton, CA 92831</p>  </div>{% elsif trinity_reference_verified %}{% unless financial_status == "paid" or financial_status == "refunded" or financial_status == "partially_refunded" or cancelled_at != blank %}<div class="payment-instructions">    <a class="payment-button" href="{{ invoice_url }}" target="_blank">Pay online</a>    <h3>Check payment</h3>    <p>If you prefer to pay by check, please make checks payable to <strong>Trinity Sports Group LLC</strong> and mail them to:</p>    <p class="payment-address">Trinity Sports Group LLC<br>2493 E Orangethorpe Ave<br>Fullerton, CA 92831</p>  </div>{% endunless %}{% endif %}  <div class="footer">Thank you for shopping with us!</div></div><style>  * { box-sizing: border-box; }  .invoice { max-width: 900px; margin: 0 auto; padding: 36px 48px 30px; color: #111; font-family: "Open Sans", Arial, sans-serif; font-size: 14px; line-height: 1.45; }  .header { display: flex; justify-content: space-between; align-items: flex-start; gap: 32px; margin-bottom: 44px; }  .brand img { display: block; max-width: 270px; max-height: 140px; width: auto; height: auto; }  .document-title { min-width: 220px; text-align: right; color: #222; }  .document-title strong { font-size: 18px; font-weight: 400; }  .addresses { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; margin-bottom: 0; padding-bottom: 24px; border-bottom: 3px solid #111; }  .addresses > div { min-width: 0; }  .addresses h3 { margin: 0 0 10px; font-size: 12px; font-weight: 700; letter-spacing: .02em; text-transform: uppercase; }  .addresses p, .addresses address { margin: 0; font-size: 13px; line-height: 1.52; }  .items { width: 100%; margin: 0 0 22px; border-collapse: collapse; font-size: 13px; }  .items th { padding: 16px 0 12px; border-bottom: 1px solid #d8d8d8; color: #111; font-size: 12px; font-weight: 700; letter-spacing: .02em; text-align: left; text-transform: uppercase; }  .items td { padding: 16px 0; border-bottom: 1px solid #d8d8d8; vertical-align: top; }  .items .right { text-align: right; }  .summary { display: flex; justify-content: flex-end; margin-top: 2px; }  .totals { width: 330px; margin-left: auto; }  .totals > div { display: flex; justify-content: space-between; gap: 24px; padding: 7px 0; }  .totals .total { margin-top: 4px; padding: 13px 0 10px; border-top: 1px solid #111; border-bottom: 3px solid #111; font-size: 15px; font-weight: 700; }  .payment-instructions { page-break-inside: avoid; margin-top: 28px; padding: 18px 0; border-top: 3px solid #111; border-bottom: 1px solid #d8d8d8; }  .payment-instructions h3 { margin: 0 0 9px; font-size: 13px; font-weight: 700; letter-spacing: .02em; text-transform: uppercase; }  .payment-instructions p { margin: 0 0 7px; }  .payment-address { font-weight: 600; }  .footer { margin-top: 34px; color: #333; font-size: 13px; text-align: center; }  .payment-button { display: inline-block; margin: 0 0 18px; padding: 11px 18px; background: #1565c0 !important; color: #fff !important; border: 1px solid #0d47a1; border-radius: 4px; font-size: 13px; font-weight: 700; line-height: 1; text-decoration: none !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }</style>